#!/bin/bash

# Unprivileged wrapper around the root profile renamer.

set -uo pipefail

here=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P) || exit 1
# shellcheck source=ofv-lib
. "$here/ofv-lib" || exit 1

old=${1:-}
new=${2:-}

for n in "$old" "$new"; do
  if [[ ! $n =~ ^[A-Za-z0-9._-]+$ || $n == "." || $n == ".." ]]; then
    echo "Invalid profile name." >&2
    exit 2
  fi
done
[[ $old != "$new" ]] || exit 0

# Resolved from the root-owned helper directory, never from this checkout; see
# ofv-lib for why that distinction is the whole point.
helper=$(ofv_root_helper ofv-rename-root) || exit 4

ofv_pkexec 180 "$helper" "$old" "$new"
