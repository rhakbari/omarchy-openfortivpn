#!/bin/bash

# Unprivileged wrapper around the root profile remover.

set -uo pipefail

here=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P) || exit 1
# shellcheck source=ofv-lib
. "$here/ofv-lib" || exit 1

name=${1:-}
if [[ ! $name =~ ^[A-Za-z0-9._-]+$ || $name == "." || $name == ".." ]]; then
  echo "Invalid profile name." >&2
  exit 2
fi

# Resolved from the root-owned helper directory, never from this checkout; see
# ofv-lib for why that distinction is the whole point.
helper=$(ofv_root_helper ofv-remove-root) || exit 4

ofv_pkexec 180 "$helper" "$name"
