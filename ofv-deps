#!/bin/bash

# Unprivileged wrapper: report setup state, or install what is missing.
#
#   ofv-deps check    -> key=value lines describing what is present
#   ofv-deps install  -> pkexec the root installer (polkit prompts)

set -uo pipefail

here=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P) || exit 1
# shellcheck source=ofv-lib
. "$here/ofv-lib" || exit 1

case "${1:-check}" in
  check)
    if command -v openfortivpn >/dev/null 2>&1; then
      printf 'openfortivpn=yes\n'
      printf 'version=%s\n' "$(openfortivpn --version 2>/dev/null | head -1 | tr -cd 'A-Za-z0-9._-')"
    else
      printf 'openfortivpn=no\n'
    fi

    # The systemd template is what the widget actually drives; the binary alone
    # is not enough.
    if systemctl cat 'openfortivpn@.service' >/dev/null 2>&1; then
      printf 'unit=yes\n'
    else
      printf 'unit=no\n'
    fi

    if command -v pacman >/dev/null 2>&1; then
      printf 'installable=yes\n'
    else
      printf 'installable=no\n'
    fi

    # yes / no / stale. Without the root-owned helpers there is nothing safe to
    # hand pkexec, so the panel has to send the user to ofv-setup first.
    printf 'helpers=%s\n' "$(ofv_helpers_state)"
    printf 'setup=%s\n' "$OFV_PLUGIN_DIR/ofv-setup"
    ;;

  install)
    # Resolved from the root-owned helper directory, never from this checkout;
    # see ofv-lib for why that distinction is the whole point.
    helper=$(ofv_root_helper ofv-deps-root) || exit 4
    # 300s: covers the polkit prompt plus a package download on a slow link.
    ofv_pkexec 300 "$helper"
    ;;

  *)
    echo "Usage: ofv-deps <check|install>" >&2
    exit 2
    ;;
esac
